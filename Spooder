collisionConnection = nil
inputState = {
	Forward = false,
	Backward = false,
	Left = false,
	Right = false,
}

function projectOntoPlane(vector, normal)
	return vector - normal * vector:Dot(normal)
end

function trySurfaceBasis(normal, reference)
	if not reference then
		return nil, nil
	end
	local up = projectOntoPlane(reference, normal)
	if up.Magnitude < 0.1 then
		return nil, nil
	end
	up = up.Unit
	local right = up:Cross(normal)
	if right.Magnitude < 0.1 then
		return nil, nil
	end
	return right.Unit, up
end

function getSurfaceBasis(normal, preferredUp)
	local right, up = trySurfaceBasis(normal, preferredUp)
	if right then
		return right, up
	end
	right, up = trySurfaceBasis(normal, Vector3.yAxis)
	if right then
		return right, up
	end
	right, up = trySurfaceBasis(normal, Vector3.zAxis)
	if right then
		return right, up
	end
	return trySurfaceBasis(normal, Vector3.xAxis)
end

function transportSurfaceUp(oldNormal, newNormal, up)
	oldNormal = oldNormal.Unit
	newNormal = newNormal.Unit
	local normalDot = math.clamp(oldNormal:Dot(newNormal), -1, 1)
	local transportedUp

	if normalDot > 0.999 then
		transportedUp = up
	elseif normalDot < -0.999 then
		local axis = projectOntoPlane(up, oldNormal)
		if axis.Magnitude < 0.1 then
			local right = getSurfaceBasis(oldNormal, up)
			axis = right
		end
		transportedUp = CFrame.fromAxisAngle(axis.Unit, math.pi):VectorToWorldSpace(up)
	else
		local axis = oldNormal:Cross(newNormal).Unit
		local angle = math.acos(normalDot)
		transportedUp = CFrame.fromAxisAngle(axis, angle):VectorToWorldSpace(up)
	end

	transportedUp = projectOntoPlane(transportedUp, newNormal)
	if transportedUp.Magnitude < 0.1 then
		local _, fallbackUp = getSurfaceBasis(newNormal, up)
		return fallbackUp
	end
	return transportedUp.Unit
end

function getCameraSurfaceUp(normal)
	local camera = workspace.CurrentCamera
	if not camera then
		return nil
	end
	local cameraDirection = projectOntoPlane(camera.CFrame.LookVector, normal)
	if cameraDirection.Magnitude < 0.18 then
		return nil
	end
	return cameraDirection.Unit
end

function getSignedSurfaceAngle(from, to, normal)
	from = projectOntoPlane(from, normal)
	to = projectOntoPlane(to, normal)
	if from.Magnitude < 0.1 or to.Magnitude < 0.1 then
		return 0
	end
	from = from.Unit
	to = to.Unit
	return math.atan2(normal:Dot(from:Cross(to)), math.clamp(from:Dot(to), -1, 1))
end

function getCameraDesiredUp(normal)
	local cameraUp = getCameraSurfaceUp(normal)
	if not cameraUp then
		return nil
	end
	return CFrame.fromAxisAngle(normal, cameraRotationOffset):VectorToWorldSpace(cameraUp).Unit
end

function rotateUpToward(current, target, normal, maxAngle)
	local from = projectOntoPlane(current, normal)
	local to = projectOntoPlane(target, normal)
	if from.Magnitude < 0.1 or to.Magnitude < 0.1 then
		return current
	end
	from = from.Unit
	to = to.Unit
	local angle = math.acos(math.clamp(from:Dot(to), -1, 1))
	if angle < 0.001 then
		return to
	end
	local direction = normal:Dot(from:Cross(to))
	local sign = direction < 0 and -1 or 1
	local step = math.min(angle, maxAngle) * sign
	return CFrame.fromAxisAngle(normal, step):VectorToWorldSpace(from).Unit
end

function isCharacterPart(instance)
	local model = instance and instance:FindFirstAncestorOfClass("Model")
	return model and model ~= character and model:FindFirstChildOfClass("Humanoid") ~= nil
end

function projectedSpan(part, axis)
	local frame = part.CFrame
	local size = part.Size
	return math.abs(axis:Dot(frame.RightVector)) * size.X
		+ math.abs(axis:Dot(frame.UpVector)) * size.Y
		+ math.abs(axis:Dot(frame.LookVector)) * size.Z
end

function isClimbable(result)
	if not result then
		return false
	end

	local instance = result.Instance
	if instance == workspace.Terrain then
		return true
	end
	if not instance:IsA("BasePart") or not instance.CanCollide or isCharacterPart(instance) then
		return false
	end
	if instance:GetAttribute("Climbable") == false or CollectionService:HasTag(instance, "NoClimb") then
		return false
	end
	if instance:GetAttribute("Climbable") == true then
		return true
	end

	local preferredUp = Vector3.yAxis
	if math.abs(result.Normal.Y) > 0.6 then
		local facing = projectOntoPlane(rootPart.CFrame.LookVector, result.Normal)
		if facing.Magnitude > 0.1 then
			preferredUp = facing.Unit
		end
	end
	local right, up = getSurfaceBasis(result.Normal, preferredUp)
	if not right then
		return false
	end

	return projectedSpan(instance, right) >= MIN_WALL_WIDTH
		and projectedSpan(instance, up) >= MIN_WALL_HEIGHT
end

function blocksClimbRay(instance)
	return instance:IsA("BasePart")
		and (instance:GetAttribute("Climbable") == false or CollectionService:HasTag(instance, "NoClimb"))
end

function cast(origin, direction)
	local result = workspace:Raycast(origin, direction, raycastParams)
	if isClimbable(result) then
		return result
	end
	if not result or blocksClimbRay(result.Instance) then
		return nil
	end

	local ignored = {character, result.Instance}
	for _ = 1, 4 do
		piercingRaycastParams.FilterDescendantsInstances = ignored
		result = workspace:Raycast(origin, direction, piercingRaycastParams)
		if isClimbable(result) then
			return result
		end
		if not result or blocksClimbRay(result.Instance) then
			return nil
		end
		table.insert(ignored, result.Instance)
	end
	return nil
end

function findWallAhead()
	local forward = projectOntoPlane(rootPart.CFrame.LookVector, Vector3.yAxis)
	if forward.Magnitude < 0.1 then
		return nil
	end
	forward = forward.Unit

	local right = rootPart.CFrame.RightVector
	local origin = rootPart.Position
	local offsets = {
		Vector3.zero,
		Vector3.new(0, 1.1, 0),
		Vector3.new(0, -1.1, 0),
		right * 0.8,
		right * -0.8,
	}

	local closest
	local closestDistance = math.huge
	for _, offset in offsets do
		local result = cast(origin + offset, forward * DETECTION_DISTANCE)
		if result then
			local distance = (result.Position - origin).Magnitude
			if distance < closestDistance then
				closest = result
				closestDistance = distance
			end
		end
	end
	return closest
end

function findSupportingSurface()
	local origin = rootPart.Position + Vector3.yAxis * 0.5
	local right = projectOntoPlane(rootPart.CFrame.RightVector, Vector3.yAxis)
	local forward = projectOntoPlane(rootPart.CFrame.LookVector, Vector3.yAxis)
	local offsets = {Vector3.zero}
	if right.Magnitude > 0.1 then
		right = right.Unit
		table.insert(offsets, right * 0.7)
		table.insert(offsets, right * -0.7)
	end
	if forward.Magnitude > 0.1 then
		forward = forward.Unit
		table.insert(offsets, forward * 0.7)
		table.insert(offsets, forward * -0.7)
	end

	local closest
	local closestDistance = math.huge
	for _, offset in offsets do
		local result = cast(origin + offset, -Vector3.yAxis * FLOOR_DETECTION_DISTANCE)
		if result then
			local distance = (result.Position - origin).Magnitude
			if distance < closestDistance then
				closest = result
				closestDistance = distance
			end
		end
	end
	return closest
end

function findCurrentSurface(surfacePoint, normal)
	local origin = surfacePoint + normal * (WALL_OFFSET + 1)
	return cast(origin, -normal * (WALL_OFFSET + 2))
end

function findConcaveSurface(surfacePoint, normal, moveDirection, triggerDistance)
	if moveDirection.Magnitude < 0.05 then
		return nil
	end

	local direction = moveDirection.Unit
	local concaveOffsets = {WALL_OFFSET + 1, WALL_OFFSET + 1.75, WALL_OFFSET + 2.75}
	local concaveBacksteps = {0.25, 0.75, 1.5}
	for index, normalOffset in concaveOffsets do
		local backstep = concaveBacksteps[index]
		local origin = surfacePoint + normal * normalOffset - direction * backstep
		local distance = triggerDistance and triggerDistance + backstep or WALL_OFFSET * 2 + 4 + index
		local result = cast(origin, direction * distance)
		if result
			and result.Normal.Unit:Dot(normal) < SURFACE_CHANGE_THRESHOLD
			and result.Normal.Unit:Dot(direction) < -0.35
		then
			return result
		end
	end
	return nil
end

function findConvexSurface(surfacePoint, normal, moveDirection)
	if moveDirection.Magnitude < 0.05 then
		return nil
	end

	local direction = moveDirection.Unit
	local convexDepths = {0.25, 0.75, 1.5, 2.75, 4}
	for index, depth in convexDepths do
		local origin = surfacePoint - normal * depth + direction * (WALL_OFFSET + 1.25 + depth * 0.5)
		local result = cast(origin, -direction * (WALL_OFFSET * 2 + 4 + index + depth))
		if result then
			local advance = (result.Position - surfacePoint):Dot(direction)
			if result.Normal.Unit:Dot(normal) < SURFACE_CHANGE_THRESHOLD
				and result.Normal.Unit:Dot(direction) > 0.2
				and advance > -3
				and advance < 3.5
			then
				return result
			end
		end
	end
	return nil
end

function findCornerSurface(surfacePoint, normal, moveDirection)
	local concave = findConcaveSurface(surfacePoint, normal, moveDirection)
	if concave then
		return concave
	end
	return findConvexSurface(surfacePoint, normal, moveDirection)
end

function getInputVector()
	local x = (inputState.Right and 1 or 0) - (inputState.Left and 1 or 0)
	local y = (inputState.Forward and 1 or 0) - (inputState.Backward and 1 or 0)
	local vector = Vector2.new(x, y)
	if vector.Magnitude > 1 then
		vector = vector.Unit
	end
	return vector
end

inputByKey = {
	[Enum.KeyCode.W] = "Forward",
	[Enum.KeyCode.S] = "Backward",
	[Enum.KeyCode.A] = "Left",
	[Enum.KeyCode.D] = "Right",
}

function onMoveAction(_, inputStateValue, inputObject)
	local direction = inputByKey[inputObject.KeyCode]
	if direction then
		inputState[direction] = inputStateValue == Enum.UserInputState.Begin or inputStateValue == Enum.UserInputState.Change
	end
	return Enum.ContextActionResult.Sink
end

function clearInput()
	for direction in inputState do
		inputState[direction] = false
	end
end

function bindMovement()
	if moveBound then
		return
	end
	moveBound = true
	ContextActionService:BindActionAtPriority(
		MOVE_ACTION,
		onMoveAction,
		false,
		ACTION_PRIORITY,
		Enum.KeyCode.W,
		Enum.KeyCode.A,
		Enum.KeyCode.S,
		Enum.KeyCode.D
	)
end

function unbindMovement()
	if not moveBound then
		return
	end
	moveBound = false
	ContextActionService:UnbindAction(MOVE_ACTION)
	clearInput()
end

function getClimbAnimation()
	local animate = character:FindFirstChild("Animate")
	local climb = animate and animate:FindFirstChild("climb")
	local configured = climb and climb:FindFirstChildWhichIsA("Animation")
	if configured and configured.AnimationId ~= "" then
		return configured
	end

	local fallback = Instance.new("Animation")
	fallback.Name = "SpiderClimbAnimation"
	fallback.AnimationId = humanoid.RigType == Enum.HumanoidRigType.R6
		and "rbxassetid://180436334"
		or "rbxassetid://507765644"
	fallback.Parent = character
	return fallback
end

function ensureAnimation()
	if climbTrack then
		return climbTrack
	end
	local success, track = pcall(function()
		return animator:LoadAnimation(getClimbAnimation())
	end)
	if success then
		climbTrack = track
		climbTrack.Looped = true
		climbTrack.Priority = Enum.AnimationPriority.Action
	end
	return climbTrack
end

function setAnimationSpeed(speed)
	local track = ensureAnimation()
	if not track then
		return
	end
	if not track.IsPlaying then
		track:Play(0.18, 1, speed)
		lastAnimationSpeed = speed
	elseif math.abs(lastAnimationSpeed - speed) > 0.04 then
		track:AdjustSpeed(speed)
		lastAnimationSpeed = speed
	end
end

function stopAnimation2()
	if climbTrack and climbTrack.IsPlaying then
		climbTrack:Stop(0.18)
	end
	lastAnimationSpeed = -1
end

local function createConstraints()
	if attachment then
		return
	end

	attachment = Instance.new("Attachment")
	attachment.Name = "SpiderClimbAttachment"
	attachment.Parent = rootPart

	alignPosition = Instance.new("AlignPosition")
	alignPosition.Name = "SpiderClimbPosition"
	alignPosition.Mode = Enum.PositionAlignmentMode.OneAttachment
	alignPosition.Attachment0 = attachment
	alignPosition.ApplyAtCenterOfMass = true
	alignPosition.MaxForce = 500000
	alignPosition.MaxVelocity = CLIMB_SPEED * 2.5
	alignPosition.Responsiveness = POSITION_RESPONSE
	alignPosition.RigidityEnabled = false
	alignPosition.Enabled = false
	alignPosition.Parent = rootPart

	alignOrientation = Instance.new("AlignOrientation")
	alignOrientation.Name = "SpiderClimbOrientation"
	alignOrientation.Mode = Enum.OrientationAlignmentMode.OneAttachment
	alignOrientation.Attachment0 = attachment
	alignOrientation.MaxTorque = 500000
	alignOrientation.MaxAngularVelocity = 40
	alignOrientation.Responsiveness = ORIENTATION_RESPONSE
	alignOrientation.RigidityEnabled = false
	alignOrientation.Enabled = false
	alignOrientation.Parent = rootPart
end

local function disableCharacterCollisions()
	table.clear(savedPartCollisions)
	for _, descendant in character:GetDescendants() do
		if descendant:IsA("BasePart") then
			savedPartCollisions[descendant] = descendant.CanCollide
			descendant.CanCollide = false
		end
	end
	if collisionConnection then
		collisionConnection:Disconnect()
	end
	collisionConnection = character.DescendantAdded:Connect(function(descendant)
		if descendant:IsA("BasePart") and savedPartCollisions[descendant] == nil then
			savedPartCollisions[descendant] = descendant.CanCollide
			descendant.CanCollide = false
		end
	end)
end

local function maintainCharacterCollisions()
	for part in savedPartCollisions do
		if part.Parent and part.CanCollide then
			part.CanCollide = false
		end
	end
end

local function restoreCharacterCollisions()
	if collisionConnection then
		collisionConnection:Disconnect()
		collisionConnection = nil
	end
	for part, canCollide in savedPartCollisions do
		if part.Parent then
			part.CanCollide = canCollide
		end
	end
	table.clear(savedPartCollisions)
end

local function setSurface(result, up, surfacePoint)
	surfaceNormal = result.Normal.Unit
	local projectedUp = projectOntoPlane(up, surfaceNormal)
	if projectedUp.Magnitude < 0.1 then
		local _, fallbackUp = getSurfaceBasis(surfaceNormal, currentUp)
		projectedUp = fallbackUp
	end
	surfaceUp = projectedUp.Unit
	targetSurfacePoint = surfacePoint or result.Position
	currentSurfacePart = result.Instance:IsA("BasePart") and result.Instance or nil
	if currentSurfacePart then
		currentSurfaceLocalPoint = currentSurfacePart.CFrame:PointToObjectSpace(targetSurfacePoint)
		currentSurfaceLocalNormal = currentSurfacePart.CFrame:VectorToObjectSpace(surfaceNormal)
		currentSurfaceLocalUp = currentSurfacePart.CFrame:VectorToObjectSpace(surfaceUp)
	else
		currentSurfaceLocalPoint = nil
		currentSurfaceLocalNormal = nil
		currentSurfaceLocalUp = nil
	end
end

local function setStoredSurfaceUp(up)
	local projectedUp = projectOntoPlane(up, surfaceNormal)
	if projectedUp.Magnitude < 0.1 then
		return
	end
	surfaceUp = projectedUp.Unit
	if currentSurfacePart then
		currentSurfaceLocalUp = currentSurfacePart.CFrame:VectorToObjectSpace(surfaceUp)
	end
end

local function refreshMovingSurface()
	if not currentSurfacePart or not currentSurfacePart.Parent then
		return
	end
	targetSurfacePoint = currentSurfacePart.CFrame:PointToWorldSpace(currentSurfaceLocalPoint)
	surfaceNormal = currentSurfacePart.CFrame:VectorToWorldSpace(currentSurfaceLocalNormal).Unit
	surfaceUp = currentSurfacePart.CFrame:VectorToWorldSpace(currentSurfaceLocalUp).Unit
end

local function detach()
	if not attached then
		return
	end

	attached = false
	cameraRotationOffset = 0
	transitioning = false
	transitionProgress = 0
	transitionStartFrame = nil
	transitionEndFrame = nil
	transitionStartPosition = nil
	transitionControlPosition1 = nil
	transitionControlPosition2 = nil
	transitionEndPosition = nil
	currentOffset = WALL_OFFSET
	currentSurfacePart = nil
	currentSurfaceLocalPoint = nil
	currentSurfaceLocalNormal = nil
	currentSurfaceLocalUp = nil
	targetSurfacePoint = nil
	character:SetAttribute("IsWallClimbing", false)
	unbindMovement()

	if alignPosition then
		alignPosition.Enabled = false
	end
	if alignOrientation then
		alignOrientation.Enabled = false
	end
	restoreCharacterCollisions()

	humanoid.AutoRotate = savedAutoRotate
	humanoid.PlatformStand = savedPlatformStand
	local velocity = rootPart.AssemblyLinearVelocity
	rootPart.AssemblyLinearVelocity = Vector3.new(velocity.X, math.min(velocity.Y, 0), velocity.Z)
	if humanoid.Health > 0 then
		humanoid:ChangeState(Enum.HumanoidStateType.Freefall)
	end
end

local function attach(result)
	if attached or not isClimbable(result) then
		return
	end

	local right, up = getSurfaceBasis(result.Normal, Vector3.yAxis)
	if not right then
		return
	end

	createConstraints()
	savedAutoRotate = humanoid.AutoRotate
	savedPlatformStand = humanoid.PlatformStand
	disableCharacterCollisions()
	currentNormal = result.Normal.Unit
	currentUp = up
	currentOffset = WALL_OFFSET
	setSurface(result, up)
	lastSurfaceTime = os.clock()
	transitioning = false
	transitionProgress = 0
	attached = true
	character:SetAttribute("IsWallClimbing", true)
	bindMovement()

	humanoid.AutoRotate = false
	humanoid.PlatformStand = true
	rootPart.AssemblyLinearVelocity = Vector3.zero
	rootPart.AssemblyAngularVelocity = Vector3.zero

	alignPosition.Position = targetSurfacePoint + currentNormal * WALL_OFFSET
	alignOrientation.CFrame = CFrame.fromMatrix(Vector3.zero, right, up, currentNormal)
	alignPosition.Enabled = true
	alignOrientation.Enabled = true
end

local function setMode(enabled)
	if destroyed or humanoid.Health <= 0 or modeEnabled == enabled then
		return
	end

	modeEnabled = enabled
	character:SetAttribute("ClimbModeEnabled", enabled)

	if enabled then
		setAnimationSpeed(0.55)
		local supportingSurface = findSupportingSurface()
		if supportingSurface then
			attach(supportingSurface)
		end
	else
		detach()
		stopAnimation2()
	end
end

local function onToggleAction(_, inputStateValue)
	if inputStateValue ~= Enum.UserInputState.Begin then
		return Enum.ContextActionResult.Sink
	end
	if UserInputService:GetFocusedTextBox() then
		return Enum.ContextActionResult.Pass
	end
	setMode(not modeEnabled)
	return Enum.ContextActionResult.Sink
end

local function onClimbJumpAction(_, inputStateValue)
	if inputStateValue ~= Enum.UserInputState.Begin then
		return attached and Enum.ContextActionResult.Sink or Enum.ContextActionResult.Pass
	end
	if UserInputService:GetFocusedTextBox() or not attached then
		return Enum.ContextActionResult.Pass
	end
	local frame = rootPart.CFrame
	local backward = frame:VectorToWorldSpace(Vector3.zAxis).Unit
	local upward = frame:VectorToWorldSpace(Vector3.yAxis).Unit
	setMode(false)
	rootPart.AssemblyLinearVelocity = (backward * CLIMB_JUMP_BACKWARD_SPEED
		+ upward * CLIMB_JUMP_UPWARD_SPEED) * CLIMB_JUMP_FORCE_MULTIPLIER
	rootPart.AssemblyAngularVelocity = Vector3.zero
	if humanoid.Health > 0 then
		humanoid:ChangeState(Enum.HumanoidStateType.Freefall)
	end
	return Enum.ContextActionResult.Sink
end

local function setCameraRotationMode(enabled)
	if cameraRotationEnabled == enabled then
		return
	end
	cameraRotationEnabled = enabled
	cameraRotationOffset = 0
	character:SetAttribute("CameraClimbRotationEnabled", enabled)

	if not attached then
		return
	end

	if enabled then
		local cameraUp = getCameraDesiredUp(surfaceNormal)
		if cameraUp then
			setStoredSurfaceUp(cameraUp)
		end
	else
		setStoredSurfaceUp(currentUp)
	end
end

local function onCameraToggleAction(_, inputStateValue)
	if inputStateValue ~= Enum.UserInputState.Begin then
		return Enum.ContextActionResult.Sink
	end
	if UserInputService:GetFocusedTextBox() then
		return Enum.ContextActionResult.Pass
	end
	setCameraRotationMode(not cameraRotationEnabled)
	return Enum.ContextActionResult.Sink
end

local function cubicBezier(point0, point1, point2, point3, alpha)
	local a = point0:Lerp(point1, alpha)
	local b = point1:Lerp(point2, alpha)
	local c = point2:Lerp(point3, alpha)
	return a:Lerp(b, alpha):Lerp(b:Lerp(c, alpha), alpha)
end

local function beginCornerTransition(result, input, oldSurfaceNormal)
	local startNormal = currentNormal
	local startUp = currentUp
	local startRight = startUp:Cross(startNormal).Unit
	local moveDirection = startRight * input.X + startUp * input.Y
	local newSurfaceNormal = result.Normal.Unit
	local isConcave = moveDirection.Magnitude > 0.05 and newSurfaceNormal:Dot(moveDirection.Unit) < -0.45
	local newSurfaceUp = transportSurfaceUp(startNormal, newSurfaceNormal, startUp)

	if cameraRotationEnabled then
		local cameraUp = getCameraSurfaceUp(newSurfaceNormal)
		if cameraUp then
			cameraRotationOffset = getSignedSurfaceAngle(cameraUp, newSurfaceUp, newSurfaceNormal)
		end
	end

	local oldSurfacePoint = targetSurfacePoint
	local correctionLimit = CORNER_OFFSET + 1.5
	local planeCorrection = math.clamp(
		(oldSurfacePoint - result.Position):Dot(oldSurfaceNormal),
		-correctionLimit,
		correctionLimit
	)
	local edgePoint = result.Position + oldSurfaceNormal * planeCorrection
	edgePoint -= newSurfaceNormal * (edgePoint - result.Position):Dot(newSurfaceNormal)

	local landingPoint
	if isConcave then
		landingPoint = edgePoint + oldSurfaceNormal * CORNER_LANDING_DISTANCE
	else
		landingPoint = result.Position - oldSurfaceNormal * CONVEX_LANDING_DISTANCE
	end
	landingPoint -= newSurfaceNormal * (landingPoint - result.Position):Dot(newSurfaceNormal)

	transitionStartFrame = CFrame.fromMatrix(Vector3.zero, startRight, startUp, startNormal)
	transitionStartPosition = alignPosition.Position
	setSurface(result, newSurfaceUp, landingPoint)
	local endRight = surfaceUp:Cross(surfaceNormal).Unit
	transitionEndFrame = CFrame.fromMatrix(Vector3.zero, endRight, surfaceUp, surfaceNormal)
	transitionEndPosition = targetSurfacePoint + surfaceNormal * WALL_OFFSET

	local clearancePoint
	if isConcave then
		clearancePoint = edgePoint + startNormal * CORNER_OFFSET + newSurfaceNormal * CORNER_OFFSET
	else
		local cornerDirection = startNormal + newSurfaceNormal
		if cornerDirection.Magnitude < 0.1 then
			cornerDirection = startNormal
		end
		clearancePoint = edgePoint + cornerDirection.Unit * CORNER_OFFSET
	end
	transitionControlPosition1 = transitionStartPosition:Lerp(clearancePoint, 0.72)
	transitionControlPosition2 = transitionEndPosition:Lerp(clearancePoint, 0.72)
	transitionProgress = 0
	transitioning = true
end

local function updateCornerTransition(deltaTime)
	if currentSurfacePart and not currentSurfacePart.Parent then
		detach()
		return
	end

	transitionProgress = math.min(1, transitionProgress + deltaTime * CORNER_TRANSITION_RATE)
	local easedProgress = transitionProgress * transitionProgress * (3 - 2 * transitionProgress)
	local frame = transitionStartFrame:Lerp(transitionEndFrame, easedProgress)
	currentNormal = -frame.LookVector
	currentUp = frame.UpVector
	local right = frame.RightVector

	alignPosition.Position = cubicBezier(
		transitionStartPosition,
		transitionControlPosition1,
		transitionControlPosition2,
		transitionEndPosition,
		easedProgress
	)
	alignOrientation.CFrame = frame
	rootPart.AssemblyAngularVelocity = Vector3.zero
	setAnimationSpeed(0.85)

	if transitionProgress >= 1 then
		transitioning = false
		currentNormal = surfaceNormal
		currentUp = surfaceUp
		currentOffset = WALL_OFFSET
		local endRight = currentUp:Cross(currentNormal).Unit
		alignPosition.Position = transitionEndPosition
		alignOrientation.CFrame = CFrame.fromMatrix(Vector3.zero, endRight, currentUp, currentNormal)
	end
end

local function updateAttached(deltaTime)
	maintainCharacterCollisions()
	if transitioning then
		updateCornerTransition(deltaTime)
		return
	end

	refreshMovingSurface()

	local projectedCurrentUp = projectOntoPlane(currentUp, currentNormal)
	if projectedCurrentUp.Magnitude < 0.1 then
		local _, fallbackUp = getSurfaceBasis(currentNormal, surfaceUp)
		projectedCurrentUp = fallbackUp
	end
	currentUp = projectedCurrentUp.Unit
	local right = currentUp:Cross(currentNormal).Unit

	local input = getInputVector()
	local moveDirection = right * input.X + currentUp * input.Y
	local intendedSurfacePoint = targetSurfacePoint + moveDirection * CLIMB_SPEED * deltaTime
	local rootSurfacePoint = rootPart.Position - currentNormal * currentOffset
	local targetLead = projectOntoPlane(intendedSurfacePoint - rootSurfacePoint, currentNormal)
	if targetLead.Magnitude > MAX_TARGET_LEAD then
		intendedSurfacePoint -= targetLead - targetLead.Unit * MAX_TARGET_LEAD
	end
	local result = findCurrentSurface(intendedSurfacePoint, surfaceNormal)
	if result and moveDirection.Magnitude > 0.05 then
		cornerDetectionAccumulator += deltaTime
		if cornerDetectionAccumulator >= DETECTION_INTERVAL then
			cornerDetectionAccumulator %= DETECTION_INTERVAL
			local concave = findConcaveSurface(
				intendedSurfacePoint,
				surfaceNormal,
				moveDirection,
				CONCAVE_TRIGGER_DISTANCE
			)
			if concave then
				result = concave
			end
		end
	else
		cornerDetectionAccumulator = DETECTION_INTERVAL
	end

	if not result then
		result = findCornerSurface(intendedSurfacePoint, surfaceNormal, moveDirection)
	end

	if not result then
		if os.clock() - lastSurfaceTime > LOST_SURFACE_GRACE then
			detach()
		end
		setAnimationSpeed(input.Magnitude > 0.05 and 0.65 or 0)
		return
	end

	lastSurfaceTime = os.clock()
	local oldSurfaceNormal = surfaceNormal
	local newSurfaceNormal = result.Normal.Unit

	if newSurfaceNormal:Dot(oldSurfaceNormal) < SURFACE_CHANGE_THRESHOLD then
		beginCornerTransition(result, input, oldSurfaceNormal)
		updateCornerTransition(deltaTime)
		return
	end

	local transportedUp = projectOntoPlane(surfaceUp, newSurfaceNormal)
	if transportedUp.Magnitude < 0.1 then
		local _, fallbackUp = getSurfaceBasis(newSurfaceNormal, currentUp)
		transportedUp = fallbackUp
	end
	local desiredSurfaceUp = transportedUp.Unit
	if cameraRotationEnabled then
		local cameraUp = getCameraDesiredUp(newSurfaceNormal)
		if cameraUp then
			desiredSurfaceUp = cameraUp
		end
	end
	setSurface(result, desiredSurfaceUp)

	local alpha = math.clamp(deltaTime * NORMAL_RESPONSE, 0, 1)
	local blendedNormal = currentNormal:Lerp(surfaceNormal, alpha)
	if blendedNormal.Magnitude > 0.1 then
		currentNormal = blendedNormal.Unit
	end

	local desiredCurrentUp = projectOntoPlane(surfaceUp, currentNormal)
	if desiredCurrentUp.Magnitude < 0.1 then
		local _, fallbackUp = getSurfaceBasis(currentNormal, currentUp)
		desiredCurrentUp = fallbackUp
	end
	if cameraRotationEnabled then
		currentUp = rotateUpToward(
			currentUp,
			desiredCurrentUp.Unit,
			currentNormal,
			deltaTime * CAMERA_ROTATION_SPEED
		)
	else
		local blendedUp = currentUp:Lerp(desiredCurrentUp.Unit, alpha)
		blendedUp = projectOntoPlane(blendedUp, currentNormal)
		if blendedUp.Magnitude < 0.1 then
			local _, fallbackUp = getSurfaceBasis(currentNormal, surfaceUp)
			blendedUp = fallbackUp
		end
		currentUp = blendedUp.Unit
	end
	right = currentUp:Cross(currentNormal).Unit

	alignPosition.Position = targetSurfacePoint + currentNormal * currentOffset
	alignOrientation.CFrame = CFrame.fromMatrix(Vector3.zero, right, currentUp, currentNormal)
	rootPart.AssemblyAngularVelocity = Vector3.zero

	if input.Magnitude > 0.05 then
		setAnimationSpeed(math.clamp(CLIMB_SPEED / 16, 0.65, 1.5))
	else
		setAnimationSpeed(0)
	end
end

local function updateDetached(deltaTime)
	setAnimationSpeed(humanoid.MoveDirection.Magnitude > 0.05 and 0.7 or 0.25)
	detectionAccumulator += deltaTime
	if detectionAccumulator < DETECTION_INTERVAL then
		return
	end
	detectionAccumulator %= DETECTION_INTERVAL
	local wall = findWallAhead()
	if wall then
		attach(wall)
	end
end

