function applyReleaseVelocity(releaseType)
	local velocity = rootPart.AssemblyLinearVelocity * RELEASE_MOMENTUM_RETENTION
	local travelDirection = getTravelDirection(velocity)
	if releaseType == "Apex" then
		velocity += travelDirection * APEX_RELEASE_FORWARD_BOOST
			+ Vector3.yAxis * APEX_RELEASE_UPWARD_BOOST
	elseif releaseType == "Jump" then
		velocity += travelDirection * JUMP_FORWARD_BOOST
			+ Vector3.yAxis * JUMP_UPWARD_BOOST
	end
	rootPart.AssemblyLinearVelocity = velocity
end

