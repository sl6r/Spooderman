function startSwing()
	if not canUseWebs() or not isAirborne() then
		return false
	end
	if activeMode then
		stopActiveMode()
	end
	createWebVisual(getSwingAirTarget())
	local anchorPosition = getAnchorPosition()
	if not anchorPosition then
		clearWebVisual()
		return false
	end
	local distance = (rootPart.Position - anchorPosition).Magnitude
	swingRopeLength = distance * SWING_INITIAL_ROPE_MULTIPLIER
	swingStartedAt = os.clock()
	swingStartHeight = rootPart.Position.Y
	swingTargetApexHeight = math.clamp(
		anchorPosition.Y + APEX_ANCHOR_HEIGHT_OFFSET,
		swingStartHeight + APEX_MIN_HEIGHT_GAIN,
		swingStartHeight + APEX_MAX_HEIGHT_GAIN
	)
	swingHadDescent = rootPart.AssemblyLinearVelocity.Y <= APEX_DESCENT_SPEED
	swingAscentStarted = false
	swingAscentStartHeight = swingStartHeight
	previousSwingVerticalVelocity = rootPart.AssemblyLinearVelocity.Y
	swingPeakSpeed = rootPart.AssemblyLinearVelocity.Magnitude
	swingTravelDirection = getTravelDirection(rootPart.AssemblyLinearVelocity)
	groundedTime = 0
	activeMode = "Swing"
	setModeAttributes(activeMode)
	enableActivePhysics()
	playAnimation("SwingAnimation")
	humanoid:ChangeState(Enum.HumanoidStateType.Freefall)
	local velocity = rootPart.AssemblyLinearVelocity
	local forward = getHorizontalForward()
	local forwardSpeed = velocity:Dot(forward)
	if forwardSpeed < SWING_START_MIN_FORWARD_SPEED then
		local boost = math.min(
			SWING_START_FORWARD_BOOST,
			SWING_START_MIN_FORWARD_SPEED - forwardSpeed
		)
		rootPart.AssemblyLinearVelocity += forward * boost
	end
	return true
end

function startZip()
	if not canUseWebs() or not isAirborne() then
		return false
	end

	if activeMode then
		stopActiveMode()
	end

	createWebVisual(getCursorAirTarget(), true)

	local anchorPosition = getAnchorPosition()

	if not anchorPosition then
		clearWebVisual()
		return false
	end

	zipStartedAt = os.clock()
	activeMode = "Zip"
	setModeAttributes(activeMode)
	enableActivePhysics()
	playAnimation("WebZipAnimation")
	humanoid:ChangeState(Enum.HumanoidStateType.Freefall)
	local offset = anchorPosition - rootPart.Position
	if offset.Magnitude > 1 then
		rootPart.AssemblyLinearVelocity += offset.Unit * ZIP_START_IMPULSE
	end
	return true
end

function updateOrientation(velocity)
	if not alignOrientation or velocity.Magnitude < 3 then
		return
	end
	local forward = velocity.Unit
	local upReference = Vector3.yAxis
	if math.abs(forward:Dot(upReference)) > 0.94 then
		upReference = getHorizontalForward()
	end
	local speedAlpha = smoothStep(velocity.Magnitude / SWING_SOFT_SPEED_CAP)
	alignOrientation.CFrame = CFrame.lookAt(Vector3.zero, forward, upReference)
		* CFrame.Angles(-CHARACTER_MAX_LEAN * speedAlpha, 0, 0)
end

function getInputStrengths()
	local forward = 0
	local side = 0
	if UserInputService:IsKeyDown(Enum.KeyCode.W) then forward += 1 end
	if UserInputService:IsKeyDown(Enum.KeyCode.S) then forward -= 1 end
	if UserInputService:IsKeyDown(Enum.KeyCode.D) then side += 1 end
	if UserInputService:IsKeyDown(Enum.KeyCode.A) then side -= 1 end
	return forward, side
end

function getGroundAssist(velocity)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = {character}
	params.IgnoreWater = true
	params.RespectCanCollide = true
	local result = workspace:Raycast(rootPart.Position, -Vector3.yAxis * GROUND_ASSIST_HEIGHT, params)
	if not result then
		return 0
	end
	local proximity = 1 - math.clamp(result.Distance / GROUND_ASSIST_HEIGHT, 0, 1)
	local downwardSpeed = math.max(0, -velocity.Y)
	local brakingDistance = math.max(0.75, result.Distance - GROUND_CLEARANCE)
	local brakingAcceleration = math.clamp(
		downwardSpeed * downwardSpeed / (2 * brakingDistance),
		0,
		GROUND_MAX_BRAKE
	)
	return proximity * GROUND_ASSIST_ACCELERATION + brakingAcceleration
end

function updateSwing(deltaTime)
	local anchorPosition = getAnchorPosition()

	if not anchorPosition then
		stopSwing()
		return
	end

	local fromAnchor = rootPart.Position - anchorPosition
	local distance = fromAnchor.Magnitude

	if distance < 1 then
		stopSwing()
		return
	end

	local outward = fromAnchor.Unit
	local velocity = rootPart.AssemblyLinearVelocity
	local speed = velocity.Magnitude
	local radialVelocity = velocity:Dot(outward)
	local tangentVelocity = velocity - outward * radialVelocity
	local tangentSpeed = tangentVelocity.Magnitude
	local swingElapsed = os.clock() - swingStartedAt
	local mass = rootPart.AssemblyMass
	local force = Vector3.yAxis * mass * workspace.Gravity * SWING_GRAVITY_COMPENSATION

	if speed > swingPeakSpeed then
		swingPeakSpeed = speed
		local horizontalTravel = getHorizontalDirection(velocity)
		if horizontalTravel then swingTravelDirection = horizontalTravel end
	end

    local velocity = rootPart.AssemblyLinearVelocity
    local speed = velocity.Magnitude

    wind_sfx.Volume += (math.clamp(speed / 350, 0, 1) * 1 - wind_sfx.Volume) * deltaTime * 3

	local tensionStart = swingRopeLength * (1 - ROPE_SLACK)
	local tensionRange = math.max(2, swingRopeLength * (ROPE_SLACK + ROPE_ELASTICITY))
	local tensionAlpha = smoothStep((distance - tensionStart) / tensionRange)
	local stretch = math.max(0, distance - swingRopeLength)
	local outwardSpeed = math.max(0, radialVelocity)

	local springAcceleration = stretch * ROPE_STIFFNESS
		+ outwardSpeed * ROPE_DAMPING * tensionAlpha

	local centripetalAcceleration = tangentSpeed * tangentSpeed / math.max(distance, 1)

	local tensionAcceleration = math.clamp(
		(springAcceleration + centripetalAcceleration * ROPE_CENTRIPETAL_STRENGTH) * tensionAlpha,
		0,
		ROPE_MAX_TENSION_ACCELERATION
	)

	force -= outward * mass * tensionAcceleration

	local cameraDirection = getCameraForward()
	local cameraTangent = projectOntoPlane(cameraDirection, outward)
	local forwardTangent = projectOntoPlane(getHorizontalForward(), outward)

	if forwardTangent.Magnitude < 0.05 then forwardTangent = cameraTangent end
	if forwardTangent.Magnitude > 0.05 then forwardTangent = forwardTangent.Unit end
    
	local momentumDirection

	if tangentSpeed > 3 then
		momentumDirection = tangentVelocity.Unit
	elseif forwardTangent.Magnitude > 0.05 then
		momentumDirection = forwardTangent
	end

	if swingAscentStarted and forwardTangent.Magnitude > 0.05 then
		local ascentGuide = projectOntoPlane(
			forwardTangent * 0.8 + Vector3.yAxis,
			outward
		)

		if ascentGuide.Magnitude > 0.05 then
			ascentGuide = ascentGuide.Unit
			if momentumDirection then
				local blendedDirection = momentumDirection * 0.35 + ascentGuide * 0.65
				if blendedDirection.Magnitude > 0.05 then
					momentumDirection = blendedDirection.Unit
				end
			else
				momentumDirection = ascentGuide
			end
		end
	end

	if momentumDirection then
		local speedDeficit = math.max(0, SWING_TARGET_SPEED - tangentSpeed)
		local driveAcceleration = SWING_ACCELERATION + speedDeficit * SWING_SPEED_GAIN
		force += momentumDirection * mass * driveAcceleration
		if outwardSpeed > 0 and tensionAlpha > 0 then
			force += momentumDirection * mass * outwardSpeed * ROPE_RADIAL_CONVERSION * tensionAlpha
		end
	end

	if velocity.Y < 0 and forwardTangent.Magnitude > 0.05 then
		force += forwardTangent * mass * math.min(100, -velocity.Y * SWING_FALL_TO_FORWARD)
	end

	local forwardInput, sideInput = getInputStrengths()
	local moveDirection = projectOntoPlane(humanoid.MoveDirection, outward)

	if moveDirection.Magnitude > 0.05 then
		local inputMultiplier = forwardInput > 0 and SWING_FORWARD_INPUT_MULTIPLIER or 1
		force += moveDirection.Unit * mass * SWING_STEERING_STRENGTH * inputMultiplier
	end

	if sideInput ~= 0 then
		local camera = getCamera()
		if camera then
			local sideDirection = projectOntoPlane(camera.CFrame.RightVector, outward)
			if sideDirection.Magnitude > 0.05 then
				force += sideDirection.Unit * mass * SWING_STEERING_STRENGTH * sideInput
			end
		end
	end

	if cameraTangent.Magnitude > 0.05 then
		local cameraInfluence = cameraTangent.Unit
		local verticalInfluence = math.abs(cameraInfluence.Y) * SWING_VERTICAL_STEERING
		force += cameraInfluence * mass * (SWING_CAMERA_STEERING + verticalInfluence)
	end

	if forwardInput < 0 and tangentSpeed > 3 then
		force -= tangentVelocity.Unit * mass * SWING_BRAKE_ACCELERATION
	end

	if velocity.Y <= APEX_DESCENT_SPEED then swingHadDescent = true end

	local availableDrop = math.max(2, swingStartHeight - GROUND_CLEARANCE)
	local ascentTriggerDrop = math.min(APEX_ASSIST_TRIGGER_DROP, availableDrop)

	local shouldBeginAscent = velocity.Y >= APEX_ASCENT_SPEED
		or swingElapsed >= APEX_ASSIST_TRIGGER_TIME
			and rootPart.Position.Y <= swingStartHeight - ascentTriggerDrop

	if swingHadDescent and not swingAscentStarted and shouldBeginAscent then
		swingAscentStarted = true
		swingAscentStartHeight = rootPart.Position.Y
	end

	if swingAscentStarted then
		local heightRange = math.max(1, swingTargetApexHeight - swingAscentStartHeight)
		local heightProgress = math.clamp((rootPart.Position.Y - swingAscentStartHeight) / heightRange, 0, 1)
		local easedProgress = smoothStep(heightProgress)

		local desiredUpwardSpeed = APEX_INITIAL_UPWARD_SPEED
			+ (APEX_FINAL_UPWARD_SPEED - APEX_INITIAL_UPWARD_SPEED) * easedProgress

		local upwardDeficit = math.max(0, desiredUpwardSpeed - velocity.Y)

		local assistAcceleration = math.clamp(
			upwardDeficit * APEX_ASSIST_RESPONSE,
			0,
			APEX_ASSIST_MAX_ACCELERATION
		)

		force += Vector3.yAxis * mass * assistAcceleration
		force += Vector3.yAxis
			* mass
			* workspace.Gravity
			* APEX_GRAVITY_COMPENSATION

		if forwardTangent.Magnitude > 0.05 then
			local retainedMomentum = swingPeakSpeed * APEX_MOMENTUM_RETENTION
			local momentumDeficit = math.max(0, retainedMomentum - tangentSpeed)
			local forwardAcceleration = APEX_FORWARD_ACCELERATION
				+ momentumDeficit * APEX_MOMENTUM_GAIN
			force += forwardTangent
				* mass
				* forwardAcceleration
				* (0.55 + heightProgress * 0.45)
		end

		if rootPart.Position.Y >= swingTargetApexHeight and swingElapsed >= APEX_MIN_SWING_TIME then
			stopSwing("Apex")
			return
		end

		if previousSwingVerticalVelocity > APEX_CREST_SPEED
			and velocity.Y <= APEX_CREST_SPEED
			and heightProgress >= 0.82
			and swingElapsed >= APEX_MIN_SWING_TIME
		then
			stopSwing("Apex")
			return
		end
	end

	previousSwingVerticalVelocity = velocity.Y

	local groundAssist = getGroundAssist(velocity)

	if groundAssist > 0 then force += Vector3.yAxis * mass * groundAssist end

	if speed > SWING_SOFT_SPEED_CAP then
		force -= velocity.Unit * mass * (speed - SWING_SOFT_SPEED_CAP) * SWING_SPEED_CAP_DAMPING
	end

	if speed > SWING_MAX_SPEED then
		force -= velocity.Unit * mass * (speed - SWING_MAX_SPEED) * SWING_SPEED_CAP_DAMPING * 4
	end

	vectorForce.Force = force
	updateOrientation(velocity)

	if activeTrack and activeTrack.IsPlaying and not swingAnimationPaused then
		activeTrack:AdjustSpeed(math.clamp(speed / 65, 0.75, 1.65))
	end

	if isAirborne() then
		groundedTime = 0
	else
		groundedTime += deltaTime
		if shiftHeld and groundedTime > 0.06 then humanoid:ChangeState(Enum.HumanoidStateType.Freefall) end
		if groundedTime > GROUND_RELEASE_GRACE then
			stopSwing()
			return
		end
	end

	if swingElapsed >= APEX_MAX_SWING_TIME then stopSwing("Apex") end
end

function updateZip(deltaTime)
	local anchorPosition = getAnchorPosition()

	if not anchorPosition then
		stopZip(false)
		return
	end

	local offset = anchorPosition - rootPart.Position
	local distance = offset.Magnitude

	if distance <= ZIP_STOP_DISTANCE or os.clock() - zipStartedAt >= ZIP_MAX_DURATION then
		stopZip(true)
		return
    end

	local direction = offset.Unit
	local velocity = rootPart.AssemblyLinearVelocity
	local alongSpeed = velocity:Dot(direction)
	local lateralVelocity = velocity - direction * alongSpeed
	local desiredAlongSpeed = math.clamp(distance * 3.4, ZIP_MIN_SPEED, ZIP_MAX_SPEED)

	desiredAlongSpeed = math.max(desiredAlongSpeed, alongSpeed)

	local desiredVelocity = direction * desiredAlongSpeed + lateralVelocity * ZIP_LATERAL_RETENTION
	local acceleration = (desiredVelocity - velocity) * ZIP_RESPONSE

	acceleration += Vector3.yAxis * workspace.Gravity * ZIP_GRAVITY_COMPENSATION

	if acceleration.Magnitude > ZIP_ACCELERATION then acceleration = acceleration.Unit * ZIP_ACCELERATION end

    local speed = velocity.Magnitude

    wind_sfx.Volume += (math.clamp(speed / 350, 0, 1) * 1 - wind_sfx.Volume) * deltaTime * 3

	vectorForce.Force = acceleration * rootPart.AssemblyMass
	updateOrientation(velocity.Magnitude > 3 and velocity or direction)

	if activeTrack and activeTrack.IsPlaying then
		activeTrack:AdjustSpeed(math.clamp(velocity.Magnitude / 80, 0.85, 1.55))
	end
end

function updateAirControl(deltaTime)
	if activeMode or not canUseWebs() or not isAirborne() then return end
	local moveDirection = humanoid.MoveDirection
	if moveDirection.Magnitude < 0.05 then return end
	local velocity = rootPart.AssemblyLinearVelocity
	local horizontalVelocity = projectOntoPlane(velocity, Vector3.yAxis)
	local desiredDirection = getHorizontalDirection(moveDirection)
	if not desiredDirection then return end
	local acceleration = desiredDirection * AIR_CONTROL_ACCELERATION
	if horizontalVelocity.Magnitude > 2 then
		local currentDirection = horizontalVelocity.Unit
		local steering = desiredDirection - currentDirection * desiredDirection:Dot(currentDirection)
		if steering.Magnitude > 0.05 then acceleration += steering.Unit * AIR_STEERING_ACCELERATION end
		if horizontalVelocity.Magnitude >= AIR_CONTROL_SPEED_LIMIT
			and desiredDirection:Dot(currentDirection) > 0
		then
			acceleration -= currentDirection * acceleration:Dot(currentDirection)
		end
	end
	rootPart:ApplyImpulse(acceleration * rootPart.AssemblyMass * deltaTime)
end

function onShiftAction(_, inputStateValue)
	if UserInputService:GetFocusedTextBox() then return Enum.ContextActionResult.Pass end
	if inputStateValue == Enum.UserInputState.Begin then
		if not canUseWebs() then return Enum.ContextActionResult.Pass end
		if activeMode == "Zip" then stopZip(false) end
		shiftHeld = true
		shiftPending = true
		shiftPressedAt = os.clock()
		nextTargetAttemptAt = shiftPressedAt + SHIFT_HOLD_TIME
		return Enum.ContextActionResult.Sink
	end
	if inputStateValue == Enum.UserInputState.End or inputStateValue == Enum.UserInputState.Cancel then
		if not shiftHeld then return Enum.ContextActionResult.Pass end
		local heldDuration = os.clock() - shiftPressedAt
		shiftHeld = false
		if activeMode == "Swing" then
			shiftPending = false
			stopSwing("Manual")
		elseif shiftPending and heldDuration <= TAP_MAX_TIME and canUseWebs() then
			shiftPending = false
			startZip()
		else
			shiftPending = false
		end
		return Enum.ContextActionResult.Sink
	end
	return Enum.ContextActionResult.Sink
end

function onJumpAction(_, inputStateValue)
	if activeMode ~= "Swing" then return Enum.ContextActionResult.Pass end
	if inputStateValue == Enum.UserInputState.Begin then stopSwing("Jump") end
	return Enum.ContextActionResult.Sink
end

function getEffectAlpha(value, minimum, maximum)
	return smoothStep((value - minimum) / (maximum - minimum))
end

function updateCameraEffects(deltaTime)
	local camera = getCamera()
	if not camera then return end
	local velocity = rootPart.AssemblyLinearVelocity
	local speed = velocity.Magnitude
	local fovAlpha = getEffectAlpha(speed, FOV_START_SPEED, FOV_FULL_SPEED)
	local minimumFov = math.max(baseFieldOfView, FOV_MIN)
	local targetFieldOfView = minimumFov + (FOV_MAX - minimumFov) * fovAlpha
	local fovBlend = 1 - math.exp(-FOV_RESPONSE * deltaTime)
	camera.FieldOfView += (targetFieldOfView - camera.FieldOfView) * fovBlend
	local acceleration = (velocity - previousCameraVelocity).Magnitude / math.max(deltaTime, 1 / 240)
	previousCameraVelocity = velocity
	local speedShake = getEffectAlpha(speed, SHAKE_START_SPEED, SHAKE_FULL_SPEED)
	local accelerationShake = getEffectAlpha(acceleration, SHAKE_ACCELERATION_START, SHAKE_ACCELERATION_FULL)
	local targetShake = math.max(speedShake * 0.72, accelerationShake * 0.45)
	local shakeBlend = 1 - math.exp(-SHAKE_RESPONSE * deltaTime)
	currentShakeIntensity += (targetShake - currentShakeIntensity) * shakeBlend
	if currentShakeIntensity < 0.001 then return end
	local phase = os.clock() * SHAKE_FREQUENCY
	local positionOffset = Vector3.new(
		math.noise(phase, 0, 0),
		math.noise(0, phase, 0),
		0
	) * SHAKE_MAX_POSITION * currentShakeIntensity
	local rotationOffset = Vector3.new(
		math.noise(phase, 3, 7),
		math.noise(5, phase, 11),
		math.noise(13, 17, phase)
	) * SHAKE_MAX_ROTATION * currentShakeIntensity
	camera.CFrame *= CFrame.new(positionOffset)
		* CFrame.Angles(rotationOffset.X, rotationOffset.Y, rotationOffset.Z)
end

