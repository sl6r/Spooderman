local function getChargeAlpha(now)
	if chargeKind == "SuperJump" then
		return math.clamp((now - chargeStartedAt) / SUPER_JUMP_CHARGE_TIME, 0, 1)
	elseif chargeKind == "Slingshot" then
		return math.clamp((now - chargeStartedAt) / SLINGSHOT_CHARGE_TIME, 0, 1)
	end
	return 0
end

