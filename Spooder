function projectOntoPlane(vector, normal)
	return vector - normal * vector:Dot(normal)
end

function smoothStep(value)
	local alpha = math.clamp(value, 0, 1)
	return alpha * alpha * (3 - 2 * alpha)
end

function isClimbing()
	return character:GetAttribute("ClimbModeEnabled") == true
		or character:GetAttribute("IsWallClimbing") == true
end

function isAirborne()
	if humanoid.FloorMaterial == Enum.Material.Air then
		return true
	end
	local state = humanoid:GetState()
	return state == Enum.HumanoidStateType.Freefall
		or state == Enum.HumanoidStateType.Jumping
		or state == Enum.HumanoidStateType.FallingDown
end

function canUseWebs()
	return not destroyed and humanoid.Health > 0 and not isClimbing()
end

function getCamera()
	return workspace.CurrentCamera
end

function getCameraForward()
	local camera = getCamera()
	if camera then
		return camera.CFrame.LookVector
	end
	return rootPart.CFrame.LookVector
end

function getHorizontalDirection(vector)
	local horizontal = projectOntoPlane(vector, Vector3.yAxis)
	if horizontal.Magnitude < 0.05 then
		return nil
	end
	return horizontal.Unit
end

function getHorizontalForward()
	return getHorizontalDirection(getCameraForward())
		or getHorizontalDirection(rootPart.CFrame.LookVector)
		or Vector3.zAxis
end

function getTravelDirection(velocity)
	return getHorizontalDirection(velocity)
		or getHorizontalDirection(swingTravelDirection)
		or getHorizontalForward()
end

local function getSwingAirTarget()
	local look = getCameraForward()
	return rootPart.Position
		+ getHorizontalForward() * SWING_AIR_ANCHOR_FORWARD
		+ Vector3.yAxis
			* (SWING_AIR_ANCHOR_HEIGHT + math.clamp(look.Y, -0.35, 0.8) * SWING_AIR_AIM_HEIGHT)
end

function getCursorAirTarget()
	local camera = getCamera()
	if not camera then
		return rootPart.Position + getCameraForward() * ZIP_AIR_DISTANCE
	end
	local mouseLocation = UserInputService:GetMouseLocation()
	local ray = camera:ViewportPointToRay(mouseLocation.X, mouseLocation.Y)
	return ray.Origin + ray.Direction.Unit * ZIP_AIR_DISTANCE
end

