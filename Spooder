function getAnimationTrack(name)
	local existing = loadedTracks[name]
	if existing then
		return existing
	end
	local animation = character:FindFirstChild(name)
	if not animation or not animation:IsA("Animation") or animation.AnimationId == "" then
		return nil
	end
	local success, track = pcall(function()
		return animator:LoadAnimation(animation)
	end)
	if not success or not track then
		return nil
	end
	track.Priority = Enum.AnimationPriority.Movement
	loadedTracks[name] = track
	return track
end

function stopAnimation()
	if activeTrack then
		activeTrack:AdjustSpeed(1)
		if activeTrack.IsPlaying then
			activeTrack:Stop(0.16)
		end
	end
	activeTrack = nil
	swingAnimationPaused = false
end

function playAnimation(name)
	local track = getAnimationTrack(name)

	if not track then
		stopAnimation()
		return
	end

	if activeTrack ~= track then
		stopAnimation()
		activeTrack = track
	end

    if not track.IsPlaying then
		track:Play(0.16, 1, 1)
	end

    track.Priority = Enum.AnimationPriority.Action4

	if name == "SwingAnimation" then
		swingAnimationPaused = false
		track.Looped = false
        track.Priority = Enum.AnimationPriority.Action4
		track:AdjustSpeed(.3)
	end
end

function updateSwingAnimationHold()
	local track = loadedTracks.SwingAnimation
	if activeMode ~= "Swing" or activeTrack ~= track or not track or swingAnimationPaused then
		return
	end
	local length = track.Length
	if length <= 0 then
		return
	end
	local holdPosition = math.max(0, length - SWING_ANIMATION_HOLD_OFFSET)
	if track.TimePosition >= holdPosition or not track.IsPlaying then
		if not track.IsPlaying then
			track:Play(0, 1, 1)
		end
		track.TimePosition = holdPosition
		track:AdjustSpeed(0)
		swingAnimationPaused = true
	end
end

