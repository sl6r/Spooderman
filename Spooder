function stopCurrent()
	if currentTrack and currentTrack.IsPlaying then
		currentTrack:Stop(FADE_TIME)
	end

	currentTrack = nil
end

function playTrack(track)
	if currentTrack == track then
		return
	end

	stopCurrent()

	currentTrack = track
	track:Play(FADE_TIME, 1, 1)
end

function updateMovementAnimation()
	local state = humanoid:GetState()
	local moving = humanoid.MoveDirection.Magnitude > 0.05

	if state == Enum.HumanoidStateType.Jumping then
        if character:GetAttribute('ClimbModeEnabled') == true then
			stopCurrent()
        else
            playTrack(fallTrack)
        end
	elseif state == Enum.HumanoidStateType.Freefall then
        if character:GetAttribute('ClimbModeEnabled') == true then
			stopCurrent()
        else
            playTrack(fallTrack)
        end
	elseif state == Enum.HumanoidStateType.Running
		or state == Enum.HumanoidStateType.RunningNoPhysics
		or state == Enum.HumanoidStateType.Landed then

		if moving or character:GetAttribute('ClimbModeEnabled') == true then
			stopCurrent()
		else
			playTrack(idleTrack)
		end
	end
end

