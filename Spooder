local function launchSuperJump(chargeAlpha)
	local easedCharge = smoothStep(chargeAlpha) ^ SUPER_JUMP_CHARGE_POWER
	local upwardSpeed = lerpNumber(SUPER_JUMP_MIN_UPWARD_SPEED, SUPER_JUMP_MAX_UPWARD_SPEED, easedCharge)
	local velocity = rootPart.AssemblyLinearVelocity
	local forwardBoost = getHorizontalForward() * SUPER_JUMP_FORWARD_SPEED * easedCharge
	humanoid:ChangeState(Enum.HumanoidStateType.Freefall)
	rootPart.AssemblyLinearVelocity = velocity
		+ Vector3.yAxis * (math.max(velocity.Y, upwardSpeed) - velocity.Y)
		+ forwardBoost
	superJumpEffectStartedAt = os.clock()
	superJumpEffectEndAt = superJumpEffectStartedAt + SUPER_JUMP_EFFECT_DURATION

    local S = Instance.new('Sound', character.Head); S.SoundId = 'rbxassetid://79597801618302'; S.RollOffMaxDistance = 500; S.Volume = 1; S:Play(); game:GetService('Debris'):AddItem(S, 5)
end

local function launchSlingshot(chargeAlpha)
	local easedCharge = smoothStep(chargeAlpha) ^ SLINGSHOT_CHARGE_POWER
	local targetSpeed = lerpNumber(SLINGSHOT_MIN_SPEED, SLINGSHOT_MAX_SPEED, easedCharge)
	local direction = getSlingshotDirection()
	local velocity = rootPart.AssemblyLinearVelocity
	local speedAlongDirection = velocity:Dot(direction)
	local launchVelocity = velocity + direction * math.max(0, targetSpeed - speedAlongDirection)
	local upwardSpeed = lerpNumber(SLINGSHOT_MIN_UPWARD_SPEED, SLINGSHOT_MAX_UPWARD_SPEED, easedCharge)
	if launchVelocity.Y < upwardSpeed then
		launchVelocity += Vector3.yAxis * (upwardSpeed - launchVelocity.Y)
	end
	humanoid:ChangeState(Enum.HumanoidStateType.Freefall)
	rootPart.AssemblyLinearVelocity = launchVelocity
	slingshotActive = true
	slingshotDirection = direction
	slingshotStartPosition = rootPart.Position
	slingshotStartedAt = os.clock()
	slingshotSlowdownStarted = false
	slingshotLaunchSpeed = math.max(targetSpeed, rootPart.AssemblyLinearVelocity:Dot(direction))
	character:SetAttribute("IsSlingshotTraveling", true)
    
    local S = Instance.new('Sound', character.Head); S.SoundId = 'rbxassetid://79597801618302'; S.RollOffMaxDistance = 500; S.Volume = 1; S:Play(); game:GetService('Debris'):AddItem(S, 5)
end

local function releaseCharge(kind)
	if chargeKind ~= kind then
		return false
	end
	local chargeAlpha = getChargeAlpha(os.clock())
	clearCharge()
    print(chargeAlpha)
	if kind == "SuperJump" then
		launchSuperJump(chargeAlpha)
	else
        if chargeAlpha < .75 then
	        return
        end
		launchSlingshot(chargeAlpha)
	end
	return true
end

local function onSuperJumpAction(_, inputState)
	if inputState == Enum.UserInputState.Begin then
		if not canStartSkill(true) then
			return Enum.ContextActionResult.Pass
		end
		beginCharge("SuperJump")
		return Enum.ContextActionResult.Sink
	elseif inputState == Enum.UserInputState.End then
		return releaseCharge("SuperJump") and Enum.ContextActionResult.Sink or Enum.ContextActionResult.Pass
	elseif inputState == Enum.UserInputState.Cancel and chargeKind == "SuperJump" then
		clearCharge()
		return Enum.ContextActionResult.Sink
	end
	return chargeKind == "SuperJump" and Enum.ContextActionResult.Sink or Enum.ContextActionResult.Pass
end

local function onSlingshotAction(_, inputState)
	if inputState == Enum.UserInputState.Begin then
		if not canStartSkill(true) then
			return Enum.ContextActionResult.Pass
		end
		beginCharge("Slingshot")
		return Enum.ContextActionResult.Sink
	elseif inputState == Enum.UserInputState.End then
		return releaseCharge("Slingshot") and Enum.ContextActionResult.Sink or Enum.ContextActionResult.Pass
	elseif inputState == Enum.UserInputState.Cancel and chargeKind == "Slingshot" then
		clearCharge()
		return Enum.ContextActionResult.Sink
	end
	return chargeKind == "Slingshot" and Enum.ContextActionResult.Sink or Enum.ContextActionResult.Pass
end

local function removeAppliedFovBonus()
	if appliedFovCamera and appliedFovBonus ~= 0 then
		appliedFovCamera.FieldOfView = math.max(1, appliedFovCamera.FieldOfView - appliedFovBonus)
	end
	appliedFovBonus = 0
	appliedFovCamera = nil
end

local function getEffectTargets(now)
	local fovBonus = 0
	local shakeIntensity = 0
	if chargeKind then
		local chargeAlpha = smoothStep(getChargeAlpha(now))
		fovBonus = math.max(fovBonus, CHARGE_FOV_BONUS * chargeAlpha)
		shakeIntensity = math.max(shakeIntensity, CHARGE_SHAKE_MAX * chargeAlpha)
	end
	if now < superJumpEffectEndAt then
		local duration = math.max(SUPER_JUMP_EFFECT_DURATION, 0.01)
		local progress = math.clamp((now - superJumpEffectStartedAt) / duration, 0, 1)
		local intensity = 1 - smoothStep(progress)
		fovBonus = math.max(fovBonus, SUPER_JUMP_FOV_BONUS * intensity)
		shakeIntensity = math.max(shakeIntensity, SUPER_JUMP_SHAKE_MAX * intensity)
	end
	if slingshotActive then
		local denominator = math.max(slingshotLaunchSpeed - SLINGSHOT_END_SPEED, 1)
		local speedAlpha = math.clamp(
			(rootPart.AssemblyLinearVelocity:Dot(slingshotDirection) - SLINGSHOT_END_SPEED) / denominator,
			0,
			1
		)
		fovBonus = math.max(fovBonus, SLINGSHOT_FOV_BONUS * speedAlpha)
		shakeIntensity = math.max(shakeIntensity, SLINGSHOT_SHAKE_MAX * speedAlpha)
	end
	return fovBonus, shakeIntensity
end

local function updateCameraEffects(deltaTime)
	removeAppliedFovBonus()
	local camera = workspace.CurrentCamera
	if not camera then
		return
	end
	local targetFovBonus, targetShake = getEffectTargets(os.clock())
	local fovBlend = 1 - math.exp(-FOV_RESPONSE * deltaTime)
	local shakeBlend = 1 - math.exp(-SHAKE_RESPONSE * deltaTime)
	currentFovBonus += (targetFovBonus - currentFovBonus) * fovBlend
	currentShakeIntensity += (targetShake - currentShakeIntensity) * shakeBlend
	if currentFovBonus > 0.001 then
		camera.FieldOfView += currentFovBonus
		appliedFovBonus = currentFovBonus
		appliedFovCamera = camera
	end
	if currentShakeIntensity <= 0.001 then
		return
	end
	local phase = os.clock() * SHAKE_FREQUENCY
	local positionOffset = Vector3.new(
		math.noise(phase, 0, 0),
		math.noise(0, phase, 0),
		0
	) * SHAKE_MAX_POSITION * currentShakeIntensity
	local rotationOffset = Vector3.new(
		math.noise(phase, 3, 7),
		math.noise(5, phase, 11),
		math.noise(13, 17, phase)
	) * SHAKE_MAX_ROTATION * currentShakeIntensity
	camera.CFrame *= CFrame.new(positionOffset)
		* CFrame.Angles(rotationOffset.X, rotationOffset.Y, rotationOffset.Z)
end

local function playBackflip()
	if destroyed or humanoid.Health <= 0 or humanoid.FloorMaterial ~= Enum.Material.Air then
		return
	end

	if rootPart.AssemblyLinearVelocity.Y < BACKFLIP_MIN_UPWARD_SPEED then
		return
	end

	if character:GetAttribute("IsWallClimbing") == true or character:GetAttribute("ClimbModeEnabled") == true then
		return
	end

	if not backflipAnimation or backflipAnimation.AnimationId == "" then
		return
	end

	if loadedBackflipId ~= backflipAnimation.AnimationId then
		if backflipTrack then
			backflipTrack:Stop(BACKFLIP_FADE_TIME)
			backflipTrack:Destroy()
			backflipTrack = nil
		end

		local success, track = pcall(function()
			return animator:LoadAnimation(backflipAnimation)
		end)

		if not success or not track then
			return
		end

		backflipTrack = track
		loadedBackflipId = backflipAnimation.AnimationId
		backflipTrack.Looped = false
		backflipTrack.Priority = Enum.AnimationPriority.Action4
	end

	if backflipTrack.IsPlaying then
		backflipTrack:Stop(BACKFLIP_FADE_TIME)
	end

	backflipTrack:Play(BACKFLIP_FADE_TIME, 1, 1.7)

    character:SetAttribute('IsBackflip', true)

    local repeating = true

    task.spawn(function()
        while repeating == true do
            if character:GetAttribute("IsWebSwinging") == true or character:GetAttribute("IsWebZipping") == true or character:GetAttribute("ClimbModeEnabled") == true then
                backflipTrack:Stop()
                return
            end
            task.wait()
        end
        return
    end)

    task.delay(.9, function()
        repeating = false
        character:SetAttribute('IsBackflip', false)
        backflipTrack:Stop()
    end)
end

local function updateTraversal(deltaTime)
	if destroyed or humanoid.Health <= 0 then
		return
	end
	if chargeKind then
		local lostGround = humanoid.FloorMaterial == Enum.Material.Air
		if lostGround or isTraversalBusy() then
			clearCharge()
		else
			humanoid:Move(Vector3.zero, false)
			local velocity = rootPart.AssemblyLinearVelocity
			rootPart.AssemblyLinearVelocity = Vector3.new(0, velocity.Y, 0)
		end
	end
	if slingshotActive then
		if isTraversalBusy() then
			stopSlingshot()
			return
		end
		local now = os.clock()
		local distance = (rootPart.Position - slingshotStartPosition).Magnitude
		if distance >= SLINGSHOT_FULL_SPEED_DISTANCE then
			slingshotSlowdownStarted = true
		end
		local velocity = rootPart.AssemblyLinearVelocity
		local speedAlongDirection = velocity:Dot(slingshotDirection)
		if slingshotSlowdownStarted then
			if speedAlongDirection <= SLINGSHOT_END_SPEED then
				stopSlingshot()
			else
				local nextSpeed = math.max(
					SLINGSHOT_END_SPEED,
					speedAlongDirection * math.exp(-SLINGSHOT_DECELERATION * math.min(deltaTime, 1 / 20))
				)
				rootPart.AssemblyLinearVelocity = velocity
					+ slingshotDirection * (nextSpeed - speedAlongDirection)
			end
		elseif speedAlongDirection < slingshotLaunchSpeed then
			rootPart.AssemblyLinearVelocity = velocity
				+ slingshotDirection * (slingshotLaunchSpeed - speedAlongDirection)
		end
		if slingshotActive and now - slingshotStartedAt >= SLINGSHOT_MAX_DURATION then
			stopSlingshot()
		end
	end
end

