local function smoothStep(value)
	value = math.clamp(value, 0, 1)
	return value * value * (3 - 2 * value)
end

local function lerpNumber(a, b, alpha)
	return a + (b - a) * alpha
end

local function isTraversalBusy()
	return character:GetAttribute("ClimbModeEnabled") == true
		or character:GetAttribute("IsWallClimbing") == true
		or character:GetAttribute("IsWebSwinging") == true
		or character:GetAttribute("IsWebZipping") == true
end

local function canStartSkill(needsGround)
	if destroyed or humanoid.Health <= 0 or humanoid.Sit or chargeKind or slingshotActive then
		return false
	end
	if UserInputService:GetFocusedTextBox() or isTraversalBusy() then
		return false
	end
	if needsGround and humanoid.FloorMaterial == Enum.Material.Air then
		return false
	end
	return true
end

local function getHorizontalForward()
	local camera = workspace.CurrentCamera
	local forward = camera and camera.CFrame.LookVector or rootPart.CFrame.LookVector
	forward = Vector3.new(forward.X, 0, forward.Z)
	if forward.Magnitude < 0.01 then
		forward = Vector3.new(rootPart.CFrame.LookVector.X, 0, rootPart.CFrame.LookVector.Z)
	end
	return forward.Magnitude > 0.01 and forward.Unit or Vector3.zAxis
end

local function getSlingshotDirection()
	local camera = workspace.CurrentCamera
	local look = --[[camera and camera.CFrame.LookVector or ]]rootPart.CFrame.LookVector
	local horizontal = Vector3.new(look.X, 0, look.Z)
	if horizontal.Magnitude < 0.01 then
		horizontal = getHorizontalForward()
	else
		horizontal = horizontal.Unit
	end
	local vertical = math.clamp(look.Y, SLINGSHOT_UPWARD_BIAS, SLINGSHOT_MAX_UPWARD_DIRECTION)
	return Vector3.new(horizontal.X, vertical, horizontal.Z).Unit
end

